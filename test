            adminUnsubscribe = onSnapshot(q, (snapshot) => {
                allRegistrations = [];
                let stats = { rev: 0, part: 0, app: 0, pend: 0, cin: 0 };
                
                snapshot.forEach(doc => {
                    const d = doc.data();
                    allRegistrations.push(d);
                    
                    stats.part += d.participants.length;
                    if(d.status === 'approved') {
                        stats.app++;
                        stats.rev += d.totalAmount;
                    }
                    if(d.status === 'pending') stats.pend++;
                    if(d.checkIn) stats.cin++;
                });

                // Update Stats UI
                document.getElementById('stat-revenue').innerText = `RM ${stats.rev}`;
                document.getElementById('stat-participants').innerText = stats.part;
                document.getElementById('stat-approved').innerText = stats.app;
                document.getElementById('stat-pending').innerText = stats.pend;
                document.getElementById('stat-checkedin').innerText = stats.cin;

                renderAdminTable(allRegistrations);
