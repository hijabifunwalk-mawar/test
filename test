<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pink October Walk 2026</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        pink: {
                            50: '#fdf2f8',
                            100: '#fce7f3',
                            500: '#ec4899',
                            600: '#db2777',
                            700: '#be185d',
                            800: '#9d174d',
                        },
                        dark: '#1f2937'
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f9fafb; scroll-behavior: smooth; }
        .hidden-view { display: none !important; }
        .gradient-text {
            background: linear-gradient(to right, #ec4899, #be185d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-bg {
            background: linear-gradient(135deg, #fce7f3 0%, #fdf2f8 100%);
            position: relative;
            overflow: hidden;
        }
        .hero-bg::before {
            content: '';
            position: absolute;
            top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(236,72,153,0.1) 0%, transparent 50%);
            animation: pulseBg 15s infinite linear;
        }
        @keyframes pulseBg {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #fbcfe8; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #f472b6; }
        
        /* Toast Notifications */
        #toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 9999; }
        .toast { background: white; border-left: 4px solid #ec4899; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); padding: 16px; margin-top: 10px; border-radius: 8px; display: flex; align-items: center; justify-content: space-between; min-width: 300px; animation: slideIn 0.3s ease-out forwards; }
        .toast.success { border-color: #10b981; }
        .toast.error { border-color: #ef4444; }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }

        /* Loader */
        .loader { border: 3px solid #f3f3f3; border-top: 3px solid #ec4899; border-radius: 50%; width: 24px; height: 24px; animation: spin 1s linear infinite; display: inline-block; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        /* Certificate Print Styles */
        @media print {
            body * { visibility: hidden; }
            #certificate-print-area, #certificate-print-area * { visibility: visible; }
            #certificate-print-area { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
</head>
<body class="text-gray-800 antialiased flex flex-col min-h-screen">

    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center cursor-pointer" onclick="navigate('home')">
                    <i class="fa-solid fa-ribbon text-pink-500 text-3xl mr-2"></i>
                    <span class="font-bold text-xl tracking-tight text-dark">Pink October <span class="text-pink-600">Walk</span></span>
                </div>
                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center space-x-6">
                    <a href="#about" class="text-gray-600 hover:text-pink-600 font-medium transition" onclick="navigate('home')">Tentang Program</a>
                    <a href="#packages" class="text-gray-600 hover:text-pink-600 font-medium transition" onclick="navigate('home')">Pakej</a>
                    <a href="#" class="text-gray-600 hover:text-pink-600 font-medium transition" onclick="navigate('status')">Semak Pendaftaran</a>
                    <a href="#" class="text-gray-600 hover:text-pink-600 font-medium transition" onclick="navigate('admin-login')"><i class="fa-solid fa-lock text-sm"></i> Admin</a>
                    <button onclick="navigate('register')" class="bg-pink-600 hover:bg-pink-700 text-white px-5 py-2 rounded-full font-semibold shadow-md transition transform hover:-translate-y-0.5">Daftar Sekarang</button>
                </div>
                <!-- Mobile Menu Button -->
                <div class="flex items-center md:hidden">
                    <button id="mobile-menu-btn" class="text-gray-600 hover:text-pink-600 focus:outline-none">
                        <i class="fa-solid fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Mobile Menu (Hidden by default) -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-t pb-4">
            <div class="px-2 pt-2 space-y-1">
                <a href="#" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-pink-600 hover:bg-pink-50" onclick="navigate('home'); toggleMobileMenu()">Utama</a>
                <a href="#" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-pink-600 hover:bg-pink-50" onclick="navigate('status'); toggleMobileMenu()">Semak Pendaftaran</a>
                <a href="#" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-pink-600 hover:bg-pink-50" onclick="navigate('admin-login'); toggleMobileMenu()">Admin Login</a>
                <button onclick="navigate('register'); toggleMobileMenu()" class="w-full text-left block px-3 py-2 bg-pink-600 text-white rounded-md text-base font-bold mt-2">Daftar Sekarang</button>
            </div>
        </div>
    </nav>

    <!-- Global App Loader -->
    <div id="app-loader" class="fixed inset-0 bg-white bg-opacity-90 z-[100] flex flex-col items-center justify-center">
        <div class="loader mb-4" style="width: 50px; height: 50px; border-width: 5px;"></div>
        <p class="text-pink-600 font-semibold animate-pulse">Memuatkan Sistem...</p>
    </div>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-grow">
        
        <div id="view-home" class="view-section">
            <!-- Hero Section -->
            <section class="hero-bg py-20 px-4 sm:px-6 lg:px-8 text-center border-b border-pink-100">
                <div class="max-w-4xl mx-auto relative z-10">
                    <span class="inline-block py-1 px-3 rounded-full bg-pink-100 text-pink-700 font-semibold text-sm mb-4 border border-pink-200 shadow-sm"><i class="fa-solid fa-bullhorn mr-1"></i> Pendaftaran Kini Dibuka!</span>
                    <h1 class="text-5xl md:text-7xl font-extrabold text-dark tracking-tight mb-4">
                        PINK OCTOBER <span class="text-pink-600">WALK 2026</span>
                    </h1>
                    <p class="text-xl md:text-2xl text-gray-600 font-medium mb-8">
                        “Langkah Bersama, Kesedaran Untuk Semua”
                    </p>
                    
                    <div class="bg-white/80 backdrop-blur-md rounded-2xl p-6 shadow-xl inline-block mb-10 border border-white">
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
                            <div>
                                <i class="fa-regular fa-calendar text-2xl text-pink-500 mb-2"></i>
                                <p class="text-sm text-gray-500 uppercase tracking-wider">Tarikh</p>
                                <p class="font-bold text-gray-800">31 Oktober 2026</p>
                            </div>
                            <div>
                                <i class="fa-regular fa-clock text-2xl text-pink-500 mb-2"></i>
                                <p class="text-sm text-gray-500 uppercase tracking-wider">Masa</p>
                                <p class="font-bold text-gray-800">7.00 Pagi</p>
                            </div>
                            <div>
                                <i class="fa-solid fa-location-dot text-2xl text-pink-500 mb-2"></i>
                                <p class="text-sm text-gray-500 uppercase tracking-wider">Tempat</p>
                                <p class="font-bold text-gray-800 text-sm">Kompleks Sukan<br>Negeri Terengganu</p>
                            </div>
                            <div>
                                <i class="fa-solid fa-users text-2xl text-pink-500 mb-2"></i>
                                <p class="text-sm text-gray-500 uppercase tracking-wider">Penyertaan</p>
                                <p class="font-bold text-gray-800">Terbuka</p>
                            </div>
                        </div>
                    </div>

                    <!-- Countdown -->
                    <div class="mb-10">
                        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-widest mb-3">Masa Tinggal</h3>
                        <div class="flex justify-center gap-4" id="countdown-timer">
                            <div class="bg-white shadow-md rounded-lg p-3 min-w-[70px]"><span id="cd-days" class="text-2xl font-bold text-pink-600">00</span><p class="text-xs text-gray-500">HARI</p></div>
                            <div class="bg-white shadow-md rounded-lg p-3 min-w-[70px]"><span id="cd-hours" class="text-2xl font-bold text-pink-600">00</span><p class="text-xs text-gray-500">JAM</p></div>
                            <div class="bg-white shadow-md rounded-lg p-3 min-w-[70px]"><span id="cd-mins" class="text-2xl font-bold text-pink-600">00</span><p class="text-xs text-gray-500">MINIT</p></div>
                            <div class="bg-white shadow-md rounded-lg p-3 min-w-[70px]"><span id="cd-secs" class="text-2xl font-bold text-pink-600">00</span><p class="text-xs text-gray-500">SAAT</p></div>
                        </div>
                    </div>

                    <button onclick="navigate('register')" class="bg-pink-600 hover:bg-pink-700 text-white text-xl px-10 py-4 rounded-full font-bold shadow-lg transition transform hover:scale-105">
                        DAFTAR SEKARANG
                    </button>
                </div>
            </section>

            <!-- Packages Section -->
            <section id="packages" class="py-20 bg-white">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-16">
                        <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">Pilih Pakej Anda</h2>
                        <p class="text-gray-600 max-w-2xl mx-auto">Sertai kami dalam menyokong kesedaran kanser payudara. Pilih pakej yang bersesuaian dengan anda.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-center" id="package-cards-container">
                        <!-- Rendered by JS -->
                    </div>
                    
                    <div class="flex justify-center mt-8 gap-8">
                         <div class="w-full md:w-1/3" id="package-card-d"></div>
                         <div class="w-full md:w-1/3" id="package-card-e"></div>
                    </div>
                </div>
            </section>

            <!-- Registration Steps -->
            <section class="py-20 bg-gray-50">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-16">
                        <h2 class="text-3xl font-bold text-dark mb-4">Cara Pendaftaran</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                            <div class="w-16 h-16 bg-pink-100 text-pink-600 rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
                            <h3 class="font-bold text-lg mb-2">Pilih Pakej & Isi Borang</h3>
                            <p class="text-gray-500 text-sm">Pilih pakej kegemaran anda (Individu atau Berkumpulan) dan isi maklumat dengan lengkap.</p>
                        </div>
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                            <div class="w-16 h-16 bg-pink-100 text-pink-600 rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
                            <h3 class="font-bold text-lg mb-2">Buat Pembayaran</h3>
                            <p class="text-gray-500 text-sm">Bayar melalui QR Pay atau Bank Transfer dan muat naik bukti resit ke dalam sistem.</p>
                        </div>
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                            <div class="w-16 h-16 bg-pink-100 text-pink-600 rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
                            <h3 class="font-bold text-lg mb-2">Terima Pengesahan</h3>
                            <p class="text-gray-500 text-sm">Dapatkan ID pendaftaran unik anda dan semak status kelulusan dari pihak admin.</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div id="view-register" class="view-section hidden-view bg-gray-50 py-10">
            <div class="max-w-4xl mx-auto px-4">
                <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-pink-100">
                    
                    <!-- Form Header -->
                    <div class="bg-gradient-to-r from-pink-600 to-pink-500 px-6 py-8 text-white text-center">
                        <h2 class="text-3xl font-bold mb-2">Borang Pendaftaran</h2>
                        <p class="text-pink-100">Pink October Walk 2026</p>
                    </div>

                    <div class="p-6 md:p-10">
                        <!-- Step Indicator -->
                        <div class="flex justify-between items-center mb-8 relative">
                            <div class="absolute left-0 top-1/2 w-full h-1 bg-gray-200 -z-10 transform -translate-y-1/2"></div>
                            <div class="w-10 h-10 rounded-full bg-pink-600 text-white flex items-center justify-center font-bold shadow-md" id="step1-ind">1</div>
                            <div class="w-10 h-10 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold border-2 border-white shadow-sm" id="step2-ind">2</div>
                            <div class="w-10 h-10 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold border-2 border-white shadow-sm" id="step3-ind">3</div>
                        </div>

                        <!-- Step 1: Participants Details -->
                        <div id="reg-step-1">
                            <div class="flex justify-between items-center mb-6">
                                <h3 class="text-xl font-bold text-dark border-b-2 border-pink-500 pb-2 inline-block">Maklumat Peserta</h3>
                                <div class="flex gap-2">
                                    <button onclick="setRegType('individual')" id="btn-type-ind" class="px-4 py-2 bg-pink-600 text-white rounded-md text-sm font-semibold transition">Individu</button>
                                    <button onclick="setRegType('group')" id="btn-type-grp" class="px-4 py-2 bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-md text-sm font-semibold transition">Berkumpulan</button>
                                </div>
                            </div>

                            <div id="participants-container" class="space-y-6">
                                <!-- Participant forms injected here -->
                            </div>

                            <div id="group-add-btn-container" class="mt-4 hidden text-center">
                                <button type="button" onclick="addParticipantForm()" class="text-pink-600 font-semibold hover:text-pink-800 bg-pink-50 px-4 py-2 rounded-lg border border-pink-200 transition">
                                    <i class="fa-solid fa-plus mr-1"></i> Tambah Peserta
                                </button>
                            </div>

                            <div class="mt-8 flex justify-end">
                                <button type="button" onclick="goToStep2()" class="bg-dark hover:bg-black text-white px-8 py-3 rounded-lg font-bold transition flex items-center">
                                    Seterusnya <i class="fa-solid fa-arrow-right ml-2"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Step 2: Payment -->
                        <div id="reg-step-2" class="hidden">
                             <h3 class="text-xl font-bold text-dark border-b-2 border-pink-500 pb-2 inline-block mb-6">Pembayaran</h3>
                             
                             <div class="bg-pink-50 rounded-xl p-6 mb-8 flex justify-between items-center border border-pink-100">
                                 <div>
                                     <p class="text-sm text-gray-600 mb-1">Jumlah Perlu Dibayar</p>
                                     <p class="text-3xl font-bold text-pink-600" id="payment-total-display">RM 0</p>
                                 </div>
                                 <div class="text-right">
                                     <p class="text-sm text-gray-600 mb-1">Jumlah Peserta</p>
                                     <p class="text-xl font-bold text-dark" id="payment-count-display">0</p>
                                 </div>
                             </div>

                             <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                                 <!-- QR Pay -->
                                 <div class="border-2 border-gray-200 rounded-xl p-6 text-center hover:border-pink-500 cursor-pointer transition" onclick="selectPaymentMethod('qr')" id="pm-qr">
                                     <i class="fa-solid fa-qrcode text-4xl text-gray-400 mb-3" id="pm-qr-icon"></i>
                                     <h4 class="font-bold text-lg mb-2">DuitNow QR</h4>
                                     <div id="qr-code-container" class="hidden mt-4">
                                         <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=DUMMY_QR_PAYMENT_DATA" alt="QR Pay" class="mx-auto rounded-lg shadow-sm w-32 h-32">
                                         <p class="text-xs text-gray-500 mt-2">Imbas untuk bayar</p>
                                     </div>
                                 </div>
                                 <!-- Bank Transfer -->
                                 <div class="border-2 border-gray-200 rounded-xl p-6 text-center hover:border-pink-500 cursor-pointer transition" onclick="selectPaymentMethod('bank')" id="pm-bank">
                                     <i class="fa-solid fa-building-columns text-4xl text-gray-400 mb-3" id="pm-bank-icon"></i>
                                     <h4 class="font-bold text-lg mb-2">Bank Transfer</h4>
                                     <div id="bank-details-container" class="hidden mt-4 text-sm text-gray-600 bg-gray-50 p-3 rounded-lg text-left">
                                         <p>Bank: <span class="font-bold text-dark" id="admin-bank-name">Bank Islam</span></p>
                                         <p>Akaun: <span class="font-bold text-dark" id="admin-bank-acc">1234567890</span></p>
                                         <p>Nama: <span class="font-bold text-dark" id="admin-bank-holder">Penganjur POW</span></p>
                                     </div>
                                 </div>
                             </div>

                             <!-- Upload Form -->
                             <div class="bg-gray-50 p-6 rounded-xl border border-gray-200 mb-8" id="upload-section">
                                 <h4 class="font-bold text-dark mb-4"><i class="fa-solid fa-cloud-arrow-up text-pink-500 mr-2"></i> Muat Naik Bukti Pembayaran</h4>
                                 
                                 <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                     <div>
                                         <label class="block text-sm font-medium text-gray-700 mb-1">Tarikh Pembayaran *</label>
                                         <input type="date" id="pay-date" class="w-full px-4 py-2 border rounded-md focus:ring-pink-500 focus:border-pink-500" required>
                                     </div>
                                     <div>
                                         <label class="block text-sm font-medium text-gray-700 mb-1">No. Rujukan / Transaksi *</label>
                                         <input type="text" id="pay-ref" class="w-full px-4 py-2 border rounded-md focus:ring-pink-500 focus:border-pink-500" placeholder="Cth: 123456ABC" required>
                                     </div>
                                 </div>
                                 
                                 <div class="mt-4">
                                     <label class="block text-sm font-medium text-gray-700 mb-1">Resit / Screenshot (Max 5MB) *</label>
                                     <input type="file" id="pay-file" accept="image/jpeg, image/png, image/jpg, application/pdf" class="w-full px-4 py-2 border rounded-md bg-white text-sm" required>
                                     <p class="text-xs text-red-500 mt-1 italic">Sila pastikan jumlah resit sepadan dengan jumlah pendaftaran (RM <span id="payment-req-amount">0</span>).</p>
                                 </div>
                                 <!-- Hidden canvas for image resizing before saving to Firestore -->
                                 <canvas id="resize-canvas" style="display:none;"></canvas>
                             </div>

                             <div class="flex justify-between mt-8">
                                <button type="button" onclick="goToStep1()" class="text-gray-500 hover:text-dark font-medium px-4 py-2">
                                    <i class="fa-solid fa-arrow-left mr-2"></i> Kembali
                                </button>
                                <button type="button" onclick="submitRegistration()" id="btn-submit-reg" class="bg-pink-600 hover:bg-pink-700 text-white px-8 py-3 rounded-lg font-bold transition flex items-center shadow-md">
                                    Hantar Pendaftaran <i class="fa-solid fa-check-circle ml-2"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Step 3: Success -->
                        <div id="reg-step-3" class="hidden text-center py-10">
                            <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                                <i class="fa-solid fa-check text-5xl text-green-500"></i>
                            </div>
                            <h2 class="text-3xl font-bold text-dark mb-2">Pendaftaran Berjaya!</h2>
                            <p class="text-gray-600 mb-6">Terima kasih kerana menyertai Pink October Walk 2026.</p>
                            
                            <div class="bg-gray-50 p-6 rounded-xl border border-gray-200 inline-block text-left mb-8 max-w-md w-full">
                                <p class="text-sm text-gray-500 uppercase mb-1">ID Pendaftaran Anda</p>
                                <p class="text-2xl font-black text-pink-600 mb-4 tracking-widest" id="success-reg-id">POW2026-XXXX</p>
                                
                                <div class="space-y-2 text-sm border-t pt-4">
                                    <div class="flex justify-between"><span class="text-gray-500">Ketua Peserta:</span> <span class="font-bold text-dark" id="success-name">-</span></div>
                                    <div class="flex justify-between"><span class="text-gray-500">Jumlah Bayaran:</span> <span class="font-bold text-dark" id="success-amount">RM -</span></div>
                                    <div class="flex justify-between"><span class="text-gray-500">Status:</span> <span class="text-yellow-600 font-bold bg-yellow-100 px-2 py-0.5 rounded text-xs">Menunggu Pengesahan</span></div>
                                </div>
                            </div>

                            <p class="text-sm text-gray-500 mb-6 italic">Sila simpan ID Pendaftaran ini untuk semakan status dan tuntutan kit.</p>

                            <div class="flex flex-col sm:flex-row justify-center gap-4">
                                <button onclick="navigate('status')" class="border-2 border-pink-600 text-pink-600 hover:bg-pink-50 px-6 py-2 rounded-full font-semibold transition">
                                    Semak Status
                                </button>
                                <button onclick="window.print()" class="bg-dark hover:bg-black text-white px-6 py-2 rounded-full font-semibold transition shadow-md">
                                    <i class="fa-solid fa-download mr-2"></i> Resit PDF
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div id="view-status" class="view-section hidden-view bg-gray-50 py-20">
            <div class="max-w-2xl mx-auto px-4">
                <div class="text-center mb-10">
                    <h2 class="text-3xl font-bold text-dark mb-4">Semak Pendaftaran</h2>
                    <p class="text-gray-600">Masukkan ID Pendaftaran atau No. Telefon untuk menyemak status.</p>
                </div>

                <div class="bg-white p-6 md:p-8 rounded-2xl shadow-md border border-gray-100 mb-8">
                    <div class="flex flex-col md:flex-row gap-4">
                        <input type="text" id="search-input" placeholder="ID (cth: POW-XXXX) / No. Tel" class="flex-grow px-4 py-3 border rounded-lg focus:ring-pink-500 focus:border-pink-500 text-lg">
