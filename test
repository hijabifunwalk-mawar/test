    <div id="toast-container"></div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, onAuthStateChanged, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, getDoc, onSnapshot, updateDoc, serverTimestamp, getDocs, query, orderBy } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global Canvas Env Variables
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'pow-app-2026';
        let firebaseConfig = {};
        try { firebaseConfig = JSON.parse(typeof __firebase_config !== 'undefined' ? __firebase_config : '{}'); } 
        catch(e) { console.warn("Using default dummy config for local testing"); }
        
        // Fallback for local testing if outside Canvas env
        if(Object.keys(firebaseConfig).length === 0) {
           firebaseConfig = { apiKey: "dummy", projectId: "dummy" }; // Won't work without actual config, but prevents crash on load
        }

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);
        let currentUserUid = null;

        // Constants & Data Models
        const DATA_COLLECTION = `registrations`; // Stored in public to allow status checks without complex rules for MVP
        const SETTINGS_DOC = `pow-settings`;
        
        // Use RULE 1 strict paths
        const getCollRef = () => collection(db, 'artifacts', appId, 'public', 'data', DATA_COLLECTION);
        const getSettingsRef = () => doc(db, 'artifacts', appId, 'public', 'data', 'settings', SETTINGS_DOC);

        const PACKAGES = {
            A: { id: 'A', name: 'Baju Muslimah', price: 50, desc: 'Baju Muslimah, Bib, Medal, e-Sijil', needsSize: true, type: 'muslimah', img: 'fa-person-dress' },
            B: { id: 'B', name: 'Baju T-Shirt', price: 40, desc: 'Baju T-Shirt (Pendek/Panjang), Bib, Medal, e-Sijil', needsSize: true, needsSleeve: true, type: 'standard', img: 'fa-shirt' },
            C: { id: 'C', name: 'Baju Kanak-Kanak', price: 35, desc: 'Baju (Pendek/Panjang), Bib, Medal, e-Sijil', needsSize: true, needsSleeve: true, type: 'kids', img: 'fa-child-reaching' },
            D: { id: 'D', name: 'Bib Sahaja', price: 20, desc: 'Bib, Medal, e-Sijil', needsSize: false, img: 'fa-address-card' },
            E: { id: 'E', name: 'Penyertaan', price: 5, desc: 'Penyertaan Sahaja, e-Sijil', needsSize: false, img: 'fa-person-walking' }
        };

        const SIZES = {
            muslimah: ['XS', 'S', 'M', 'L', 'XL', '2XL', '3XL'],
            standard: ['XS', 'S', 'M', 'L', 'XL', '2XL', '3XL'],
            kids: ['2-3 thn', '4-5 thn', '6-7 thn', '8-9 thn', '10-11 thn', '12-13 thn']
        };

        let currentRegType = 'individual';
        let participantsData = [ generateEmptyParticipant(1) ];
        let adminUnsubscribe = null;
        let allRegistrations = [];

        window.showToast = (msg, type='success') => {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `<div><i class="fa-solid ${type==='success'?'fa-circle-check text-green-500':'fa-circle-exclamation text-red-500'} mr-2"></i> ${msg}</div>`;
            container.appendChild(toast);
            setTimeout(() => { toast.style.animation = 'fadeOut 0.3s ease-out forwards'; setTimeout(()=>toast.remove(), 300); }, 3000);
        };

        window.navigate = (viewId) => {
            document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden-view'));
            document.getElementById(`view-${viewId}`).classList.remove('hidden-view');
            window.scrollTo(0,0);
            if(viewId === 'home') renderPackages();
        };

        window.toggleMobileMenu = () => {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        };

        function generateId() {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let str = '';
            for(let i=0; i<5; i++) str += chars.charAt(Math.floor(Math.random() * chars.length));
            return `POW-${str}`;
        }

        window.closeModal = (id) => { document.getElementById(id).classList.add('hidden'); };

        async function initApp() {
            // Setup Auth
            onAuthStateChanged(auth, async (user) => {
                if (user) {
                    currentUserUid = user.uid;
                    await loadSettings();
                    navigate('home');
                    document.getElementById('app-loader').style.display = 'none';
                }
            });

            // Handle custom token if available in env, else anonymous
            const token = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
            if (token) {
                try { await signInWithCustomToken(auth, token); } 
                catch (e) { console.error("Custom token failed, falling back to anon", e); signInAnonymously(auth); }
            } else {
                signInAnonymously(auth);
            }

            setupCountdown();
            renderPackages();
        }

        async function loadSettings() {
            if(!currentUserUid) return;
            try {
                const docSnap = await getDoc(getSettingsRef());
                if (docSnap.exists()) {
                    const data = docSnap.data();
                    document.getElementById('admin-bank-name').innerText = data.bankName || 'Bank Islam';
                    document.getElementById('admin-bank-acc').innerText = data.bankAcc || '1234567890';
                    document.getElementById('admin-bank-holder').innerText = data.bankHolder || 'Penganjur POW';
                    
                    // Pre-fill admin inputs if logged in
                    document.getElementById('set-bank-name').value = data.bankName || 'Bank Islam';
                    document.getElementById('set-bank-acc').value = data.bankAcc || '1234567890';
                    document.getElementById('set-bank-holder').value = data.bankHolder || 'Penganjur POW';
                }
            } catch(e) { console.log("Settings not initialized yet."); }
        }

        function setupCountdown() {
            const eventDate = new Date("Oct 31, 2026 07:00:00").getTime();
            setInterval(() => {
                const now = new Date().getTime();
                const distance = eventDate - now;
                if (distance < 0) return;
                document.getElementById('cd-days').innerText = String(Math.floor(distance / (1000 * 60 * 60 * 24))).padStart(2, '0');
                document.getElementById('cd-hours').innerText = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
                document.getElementById('cd-mins').innerText = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
                document.getElementById('cd-secs').innerText = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');
            }, 1000);
        }

        function renderPackages() {
            const container = document.getElementById('package-cards-container');
            const contD = document.getElementById('package-card-d');
            const contE = document.getElementById('package-card-e');
            container.innerHTML = ''; contD.innerHTML = ''; contE.innerHTML = '';

            const createCard = (pkg, key) => `
                <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6 flex flex-col h-full transform transition hover:-translate-y-1 hover:shadow-xl relative overflow-hidden">
                    ${key==='A' ? '<div class="absolute top-0 right-0 bg-pink-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">Popular</div>' : ''}
                    <div class="w-14 h-14 bg-pink-50 rounded-full flex items-center justify-center text-pink-600 text-2xl mb-4 mx-auto"><i class="fa-solid ${pkg.img}"></i></div>
                    <h3 class="text-xl font-bold text-center text-dark mb-1">Pakej ${key}</h3>
                    <p class="text-center font-medium text-gray-500 mb-4">${pkg.name}</p>
                    <div class="text-center mb-6"><span class="text-3xl font-black text-pink-600">RM${pkg.price}</span><span class="text-gray-400 text-sm">/pax</span></div>
                    <ul class="text-sm text-gray-600 space-y-3 mb-8 flex-grow">
                        ${pkg.desc.split(',').map(item => `<li><i class="fa-solid fa-check text-green-500 mr-2"></i>${item.trim()}</li>`).join('')}
                    </ul>
                    <button onclick="startRegistration('${key}')" class="w-full mt-auto py-3 rounded-lg border-2 border-pink-500 text-pink-600 font-bold hover:bg-pink-500 hover:text-white transition">Pilih Pakej ${key}</button>
                </div>
            `;

            Object.entries(PACKAGES).forEach(([key, pkg]) => {
                if(key==='A'||key==='B'||key==='C') container.innerHTML += createCard(pkg, key);
                else if(key==='D') contD.innerHTML = createCard(pkg, key);
                else if(key==='E') contE.innerHTML = createCard(pkg, key);
            });
        }

        window.startRegistration = (pkgKey) => {
            currentRegType = 'individual';
            participantsData = [ generateEmptyParticipant(1, pkgKey) ];
            navigate('register');
            renderRegistrationForm();
        };

        function generateEmptyParticipant(id, pkg='A') {
            return { id, name: '', ic: '', gender: 'Lelaki', phone: '', pkg, size: '', sleeve: 'Pendek' };
        }

        window.setRegType = (type) => {
            currentRegType = type;
            const btnInd = document.getElementById('btn-type-ind');
            const btnGrp = document.getElementById('btn-type-grp');
            const addBtn = document.getElementById('group-add-btn-container');

            if(type === 'individual') {
                btnInd.className = "px-4 py-2 bg-pink-600 text-white rounded-md text-sm font-semibold transition";
                btnGrp.className = "px-4 py-2 bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-md text-sm font-semibold transition";
                participantsData = [ participantsData[0] ]; // Keep only first
                addBtn.classList.add('hidden');
            } else {
                btnGrp.className = "px-4 py-2 bg-pink-600 text-white rounded-md text-sm font-semibold transition";
                btnInd.className = "px-4 py-2 bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-md text-sm font-semibold transition";
                addBtn.classList.remove('hidden');
            }
            renderRegistrationForm();
        };

        window.addParticipantForm = () => {
            if(participantsData.length >= 10) return showToast('Maksimum 10 peserta per kumpulan.', 'error');
            const newId = participantsData.length ? Math.max(...participantsData.map(p=>p.id)) + 1 : 1;
            participantsData.push(generateEmptyParticipant(newId));
            renderRegistrationForm();
        };

        window.removeParticipantForm = (id) => {
            if(participantsData.length <= 1) return;
            participantsData = participantsData.filter(p => p.id !== id);
            renderRegistrationForm();
        };

        window.updateParticipantData = (id, field, value) => {
            const p = participantsData.find(p => p.id === id);
            if(p) {
                p[field] = value;
                if(field === 'pkg') renderRegistrationForm(); // Re-render to show/hide size fields
                else calculateTotal(); // Just update total if other fields change
            }
        };

        function renderRegistrationForm() {
            const container = document.getElementById('participants-container');
            container.innerHTML = '';
            
            let pkgOptions = Object.entries(PACKAGES).map(([k, v]) => `<option value="${k}">Pakej ${k} (RM${v.price}) - ${v.name}</option>`).join('');

            participantsData.forEach((p, index) => {
                const pkgInfo = PACKAGES[p.pkg];
                let sizeHtml = '';
                let sleeveHtml = '';

                if (pkgInfo.needsSize) {
                    const sizeOptions = SIZES[pkgInfo.type].map(s => `<option value="${s}" ${p.size===s?'selected':''}>${s}</option>`).join('');
                    if(!p.size) p.size = SIZES[pkgInfo.type][0]; // set default if empty
                    
                    sizeHtml = `
                        <div class="col-span-1">
                            <label class="block text-xs font-medium text-gray-600 mb-1">Saiz Baju *</label>
                            <select onchange="updateParticipantData(${p.id}, 'size', this.value)" class="w-full px-3 py-2 border rounded-md text-sm bg-white" required>
                                ${sizeOptions}
                            </select>
                        </div>
                    `;
                }

                if (pkgInfo.needsSleeve) {
                    sleeveHtml = `
                        <div class="col-span-1">
                            <label class="block text-xs font-medium text-gray-600 mb-1">Jenis Lengan</label>
                            <select onchange="updateParticipantData(${p.id}, 'sleeve', this.value)" class="w-full px-3 py-2 border rounded-md text-sm bg-white">
                                <option value="Pendek" ${p.sleeve==='Pendek'?'selected':''}>Pendek</option>
                                <option value="Panjang" ${p.sleeve==='Panjang'?'selected':''}>Panjang</option>
                            </select>
                        </div>
                    `;
                }

                const removeBtn = index > 0 ? `<button type="button" onclick="removeParticipantForm(${p.id})" class="text-red-500 hover:text-red-700 text-sm font-semibold"><i class="fa-solid fa-trash"></i> Buang</button>` : '';

                const html = `
                    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm relative">
                        <div class="flex justify-between items-center mb-4 pb-2 border-b">
                            <h4 class="font-bold text-pink-600">Peserta ${index + 1} ${index===0?'(Ketua)':''}</h4>
                            ${removeBtn}
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">Nama Penuh (Untuk Sijil) *</label>
                                <input type="text" value="${p.name}" onchange="updateParticipantData(${p.id}, 'name', this.value)" class="w-full px-3 py-2 border rounded-md text-sm uppercase" required>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">No. IC / Passport *</label>
                                <input type="text" value="${p.ic}" onchange="updateParticipantData(${p.id}, 'ic', this.value)" class="w-full px-3 py-2 border rounded-md text-sm" required>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">No. Telefon ${index===0?'*':''}</label>
                                <input type="tel" value="${p.phone}" onchange="updateParticipantData(${p.id}, 'phone', this.value)" class="w-full px-3 py-2 border rounded-md text-sm" ${index===0?'required':''}>
                            </div>
                            <div>
